  "datasheet": "https://www.espressif.com/sites/default/files/documentation/esp32_datasheet_en.pdf",
  "verified": true,
  "summary": "Espressif's official ESP32 development board with an ESP32-WROOM-32E (or -32UE) module, CP210x USB-serial bridge and two 19-pin headers (J2, J3).",
  "warnings": [
    {
      "level": "danger",
      "text": "All I/O is 3.3 V only. Do not connect 5 V signals directly."
    },
    {
      "level": "danger",
      "text": "D0, D1, D2, D3, CMD and CLK (GPIO6-11) belong to the SPI flash. Do not use them.",
      "pins": [
        "J2-16",
        "J2-17",
        "J2-18",
        "J3-17",
        "J3-18",
        "J3-19"
      ]
    },
    {
      "level": "warn",
      "text": "Strapping pins GPIO0, GPIO2, GPIO5, GPIO12 (MTDI) and GPIO15 (MTDO) are read at reset. External pull-ups/pull-downs on them can stop the board booting; GPIO12 HIGH at reset selects 1.8 V flash voltage.",
      "pins": [
        "J3-14",
        "J3-15",
        "J3-10",
        "J2-13",
        "J3-16"
      ]
    },
    {
      "level": "warn",
      "text": "ADC2 pins (GPIO0, 2, 4, 12, 13, 14, 15, 25, 26, 27) cannot be used for analog input while Wi-Fi is on. Use ADC1 (GPIO32-39) instead.",
      "pins": [
        "J3-14",
        "J3-15",
        "J3-13",
        "J2-13",
        "J2-15",
        "J2-12",
        "J3-16",
        "J2-9",
        "J2-10",
        "J2-11"
      ]
    },
    {
      "level": "info",
      "text": "GPIO34, 35, 36 (VP) and 39 (VN) are input only and have no internal pull-up or pull-down.",
      "pins": [
        "J2-3",
        "J2-4",
        "J2-5",
        "J2-6"
      ]
    },
    {
      "level": "info",
      "text": "TX/RX (GPIO1/GPIO3) are UART0, used by the USB-serial bridge for flashing and the serial monitor.",
      "pins": [
        "J3-4",
        "J3-5"
      ]
    },
    {
      "level": "info",
      "text": "GPIO16 and GPIO17 are reserved for PSRAM on boards built with ESP32-WROVER modules.",
      "pins": [
        "J3-11",
        "J3-12"
      ]
    }
  ],
