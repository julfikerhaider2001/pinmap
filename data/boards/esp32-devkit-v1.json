  "datasheet": "https://www.espressif.com/sites/default/files/documentation/esp32_datasheet_en.pdf",
  "verified": false,
  "summary": "Common third-party ESP32 board (DOIT-style) with an ESP-WROOM-32 module and two 15-pin headers. No official board document exists; header order follows the usual DOIT layout.",
  "warnings": [
    {
      "level": "warn",
      "text": "This is a clone design with no official documentation. Pin order, labels, USB chip, buttons and LED differ between makers (30-, 36- and 38-pin versions exist). Always check the silkscreen on your board."
    },
    {
      "level": "danger",
      "text": "All I/O is 3.3 V only. Do not connect 5 V signals directly."
    },
    {
      "level": "warn",
      "text": "Strapping pins GPIO0, GPIO2, GPIO5, GPIO12 (MTDI) and GPIO15 (MTDO) are read at reset. External pull-ups/pull-downs can stop the board booting; GPIO12 HIGH at reset selects 1.8 V flash voltage. GPIO0 is not on the header; it is wired to the BOOT button on most boards.",
      "pins": [
        "J2-12",
        "J2-8",
        "J1-12",
        "J2-13"
      ]
    },
    {
      "level": "warn",
      "text": "ADC2 pins (GPIO2, 4, 12, 13, 14, 15, 25, 26, 27) cannot be used for analog input while Wi-Fi is on. Use ADC1 (GPIO32-39).",
      "pins": [
        "J2-12",
        "J2-11",
        "J1-12",
        "J1-13",
        "J1-11",
        "J2-13",
        "J1-8",
        "J1-9",
        "J1-10"
      ]
    },
    {
      "level": "info",
      "text": "GPIO34, 35, 36 (VP) and 39 (VN) are input only and have no internal pull-up or pull-down.",
      "pins": [
        "J1-2",
        "J1-3",
        "J1-4",
        "J1-5"
      ]
    },
    {
      "level": "info",
      "text": "TX0/RX0 (GPIO1/GPIO3) are UART0, used by the USB-serial chip for flashing and the serial monitor.",
      "pins": [
        "J2-3",
        "J2-4"
      ]
    }
  ],
