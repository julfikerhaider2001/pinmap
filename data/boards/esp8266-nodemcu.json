  "sources": [
    {
      "title": "ESP8266EX Datasheet",
      "url": "https://www.espressif.com/sites/default/files/documentation/0a-esp8266ex_datasheet_en.pdf",
      "rev": "v7.1",
      "note": "Table 2-1 pin definitions, boot-mode note, Chapter 4 (GPIO, SDIO, SPI/HSPI, I2C, I2S, UART, PWM, IR, ADC 0-1.0 V)."
    },
    {
      "title": "NodeMCU DevKit v1.0 schematic",
      "url": "https://github.com/nodemcu/nodemcu-devkit-v1.0/blob/master/NODEMCU_DEVKIT_V1.0.PDF",
      "rev": "V1.0 (25/01/2015)",
      "note": "IO connector J1/J2 nets, 12k boot pull-ups/down, 220k/100k ADC divider, LED on GPIO16, FLASH button on GPIO0, boot and deep-sleep notes."
    },
    {
      "title": "NodeMCU DevKit v1.0 pin map",
      "url": "https://github.com/nodemcu/nodemcu-devkit-v1.0/blob/master/Documents/NODEMCU_DEVKIT_V1.0_PINMAP.png",
      "note": "Header order and D-label to GPIO mapping. (Documents/新版本管脚对应关系.txt in the same repo swaps D1/D2; the pin map image and the schematic netlist agree on D1 = GPIO5, D2 = GPIO4.)"
    },
    {
      "title": "Arduino core for ESP8266: Reference and Libraries",
      "url": "https://arduino-esp8266.readthedocs.io/en/latest/reference.html",
      "note": "GPIO16 limits (no interrupts, INPUT_PULLDOWN_16), software PWM on pins 0-16, Wire default SDA=4/SCL=5 (libraries page)."
    }
  ],
  "datasheet": "https://www.espressif.com/sites/default/files/documentation/0a-esp8266ex_datasheet_en.pdf",
  "verified": false,
  "summary": "Open-source ESP8266 board with an ESP-12E module (4 MB flash), CP2102 USB-serial bridge and two 15-pin headers. Silkscreen uses D-labels; code uses GPIO numbers.",
  "warnings": [
    {
      "level": "danger",
      "text": "All I/O is 3.3 V only. Do not connect 5 V signals directly."
    },
    {
      "level": "warn",
      "text": "D-labels are not GPIO numbers (e.g. D1 = GPIO5, D4 = GPIO2). In Arduino code you can write D1 or 5."
    },
    {
      "level": "warn",
      "text": "Boot pins: GPIO15 (D8) must be LOW and GPIO2 (D4) HIGH at every boot/reset/wake. GPIO0 (D3) HIGH = run, LOW = flash mode. Do not load these pins with circuits that change those levels.",
      "pins": [
        "J2-11",
        "J2-5",
        "J2-4"
      ]
    },
    {
      "level": "danger",
      "text": "SD0-SD3, CMD and CLK (GPIO6-11) are the ESP-12E flash pins. Do not use them.",
      "pins": [
        "J1-4",
        "J1-5",
        "J1-6",
        "J1-7",
        "J1-8",
        "J1-9"
      ]
    },
    {
      "level": "info",
      "text": "A0 has an on-board 220k/100k divider: about 0-3.2 V at the pin maps to the chip ADC 0-1.0 V range.",
      "pins": [
        "J1-1"
      ]
    },
    {
      "level": "info",
      "text": "For deep-sleep wake, connect D0 (GPIO16) to RST. GPIO16 has no interrupts and no internal pull-up.",
      "pins": [
        "J2-1",
        "J1-13"
      ]
    },
    {
      "level": "info",
      "text": "Hardware SPI (HSPI) and UART pins are fixed. I2C and PWM are done in software and work on most GPIOs."
    },
    {
      "level": "info",
      "text": "Clones (e.g. LoLin \"V3\") use a different width, USB chip and sometimes different reserved pins. Check your board."
    }
  ],
