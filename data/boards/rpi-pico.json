    },
    {
      "title": "RP2040 Datasheet",
      "url": "https://datasheets.raspberrypi.com/rp2040/rp2040-datasheet.pdf",
      "rev": "build-date 2025-02-20, build-version 3184e62-clean",
      "note": "Table 279 GPIO function select (F1-F9); section 5.5.3 absolute maximum ratings (VPIN max IOVDD + 0.5 V, IOVDD max 3.63 V)."
    }
  ],
  "datasheet": "https://datasheets.raspberrypi.com/pico/pico-datasheet.pdf",
  "verified": true,
  "summary": "RP2040 board with 26 usable 3.3 V GPIOs, 3 ADC inputs, 2× UART/SPI/I2C on fixed pin options, 16 PWM channels and 8 PIO state machines.",
  "warnings": [
    {
      "level": "danger",
      "text": "All GPIOs are 3.3 V only. The RP2040 absolute maximum pin voltage is IOVDD + 0.5 V, so 5 V signals will damage it. Use a level shifter."
    },
    {
      "level": "info",
      "text": "Some RP2040 GPIOs are used on the board and are not on the header: GPIO23 controls the SMPS power-save pin, GPIO24 senses VBUS (high when USB power is present), GPIO25 drives the onboard LED, and GPIO29 reads VSYS/3 on ADC3."
    },
    {
      "level": "info",
      "text": "I2C, SPI and UART can only use the pins listed for them (each function has several pin options). Every GPIO has a PWM channel, but the two pins sharing a slice and channel (e.g. GP0 and GP16 are both PWM0 A) get the same output."
    },
    {
      "level": "warn",
      "text": "GP26-GP28 (ADC pins) have a reverse diode to 3.3 V. Driving them above 3.3 V + about 300 mV pulls current through the diode into the 3.3 V rail.",
      "pins": [
        "pin31",
        "pin32",
        "pin34"
      ]
    }
  ],
